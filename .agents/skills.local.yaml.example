# Per-machine config read by codexd's repo-local skill scripts.
# Copy this to .agents/skills.local.yaml (git-ignored) and adjust locally.
# Skills should read the local file first and fall back to this example.
# Codex discovers skills from .agents/skills; this file is not a discovery
# manifest.

# Path to the Culture server's agent manifest.
culture_server_yaml: ~/.culture/server.yaml

# Sibling project paths checked during alignment-delta workflows.
sibling_projects:
  - ../culture
  - ../steward
  - ../agtag
  - ../daria
